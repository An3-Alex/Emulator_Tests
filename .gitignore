# Publish source and documentation only. Owner media and local runtime state stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/*.ps1
!/*.cmd
!/scripts/
!/src/
!/include/
!/tests/
!/docs/
!/esp32-db/

# Guest images, firmware, dumps, archives, third-party binaries, build output.
*.img
*.bin
*.xc
*.exe
*.dll
*.obj
*.o
*.a
*.lib
*.pdb
*.elf
*.map
*.zip
*.7z
*.rar
*.log
*.png
*.jpg
*.pdf
*.pyc
__pycache__/

/scripts/*.bin
/tests/*.bin
/esp32-db/.generated/
/esp32-db/.tools/
/esp32-db/.venv/
/esp32-db/build/
/esp32-db/build-idf/
/esp32-db/build-idf-usb-bridge/
/esp32-db/generated/
/esp32-db/__pycache__/
